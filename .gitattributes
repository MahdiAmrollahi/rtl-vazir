# Normalize line endings to LF in the repo; let git convert to CRLF
# on Windows checkouts so tooling like PowerShell and .NET don't choke
# on mixed endings.
* text=auto eol=lf

# CSS / JS / HTML — treat as text, force LF
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Fonts are binary
*.woff2 binary
*.woff  binary
*.ttf   binary
*.eot   binary
*.png   binary
*.svg   binary
