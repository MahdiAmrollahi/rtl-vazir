{
  "manifest_version": 3,
  "name": "RTL Vazir — Persian & Mixed Direction for AI Chats",
  "version": "1.0.0",
  "description": "Renders Persian/Arabic (RTL) and English (LTR) naturally in ChatGPT, Claude, Gemini, Perplexity, Copilot, Poe, DeepSeek, Grok and more — while keeping code, math and tables untouched. Uses the Vazir font for cleaner Persian reading.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/*",
    "https://poe.com/*",
    "https://www.poe.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://chat.mistral.ai/*",
    "https://huggingface.co/*",
    "https://you.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://poe.com/*",
        "https://www.poe.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/*",
        "https://you.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/*",
        "https://poe.com/*",
        "https://www.poe.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/*",
        "https://you.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "RTL Vazir",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
